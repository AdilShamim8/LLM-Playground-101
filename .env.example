# ── Core Settings ──────────────────────────────────────────────────
# The environment name. Use 'production' for live deployments.
# When ENVIRONMENT=production, DEV_MODE must be false.
PROJECT_NAME=llm_playground
ENVIRONMENT=development           # development | staging | production
DEBUG=true

# DEV_MODE bypasses all authentication. ONLY use for local development.
# Default is false for safety — you must explicitly opt in.
# The app will CRASH if DEV_MODE=true and ENVIRONMENT=production.
DEV_MODE=false

# ── API Settings ───────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# ── Authentication ─────────────────────────────────────────────────
# Generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Must be at least 32 characters. NEVER commit the real key to git.
JWT_SECRET_KEY=generate-a-secure-32-char-key-here-using-secrets
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── Rate Limiting ──────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# ── Database ───────────────────────────────────────────────────────
DATABASE_URL=postgresql://llm_user:llm_password@localhost:5432/llm_playground
POSTGRES_USER=llm_user
POSTGRES_PASSWORD=llm_password
POSTGRES_DB=llm_playground

# ── Redis ──────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Model Storage ──────────────────────────────────────────────────
MODEL_CHECKPOINT_DIR=./checkpoints
DATA_DIR=./data
TOKENIZER_DIR=./tokenizers

# ── Training ───────────────────────────────────────────────────────
CUDA_VISIBLE_DEVICES=0
WANDB_PROJECT=llm_playground
WANDB_API_KEY=your-wandb-api-key-here

# ── UI ─────────────────────────────────────────────────────────────
UI_PORT=7860
API_BASE=http://localhost:8000/api/v1

# ── Logging ────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log